# Minimal static BusyBox profile for the LeonOS userland ABI.
#
# Ash runs behind BusyBox's `sh` entry. Its jobs and pipelines use the native
# fork/exec, process-group, PTY and waitpid implementation.
CONFIG_BUSYBOX=y
# Upstream shell packages register and remove their /etc/shells entries.
CONFIG_ADD_SHELL=y
CONFIG_REMOVE_SHELL=y
# Authentication and account tools are provided by PAM, sudo and shadow.
# CONFIG_LOGIN is not set
# CONFIG_PASSWD is not set
# CONFIG_SU is not set
# CONFIG_SULOGIN is not set
# CONFIG_CHPASSWD is not set
# CONFIG_ADDUSER is not set
# CONFIG_ADDGROUP is not set
# CONFIG_DELUSER is not set
# CONFIG_DELGROUP is not set
CONFIG_STATIC=y
# LeonOS has a paged x86_64 address space.  Ash must use its MMU fork path
# so pipelines, background jobs and process groups exercise the native COW
# implementation instead of the NOMMU vfork/re-exec fallback.
# CONFIG_NOMMU is not set
CONFIG_INSTALL_APPLET_SYMLINKS=n
CONFIG_INSTALL_APPLET_HARDLINKS=n
CONFIG_INSTALL_APPLET_SCRIPT_WRAPPERS=n
CONFIG_INSTALL_APPLET_DONT=y
CONFIG_BUSYBOX_EXEC_PATH="/bin/busybox"
CONFIG_EXTRA_LDLIBS="leonos"
CONFIG_DESKTOP=n
CONFIG_INCLUDE_SUSv2=n
CONFIG_LONG_OPTS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=n
CONFIG_FEATURE_COMPRESS_USAGE=n
# Ash's interactive line editor owns command history, cursor movement and
# tab completion.  Keep the optional history/vi layers disabled for now.
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_TAB_COMPLETION=y
CONFIG_FEATURE_USERNAME_COMPLETION=n
CONFIG_FEATURE_EDITING_VI=n
CONFIG_FEATURE_EDITING_HISTORY=0
CONFIG_FEATURE_EDITING_SAVEHISTORY=n
CONFIG_FEATURE_EDITING_SAVE_ON_EXIT=n
CONFIG_FEATURE_REVERSE_SEARCH=n
# Ash parses prompt escapes such as \\w and \\$ and excludes ANSI color
# sequences wrapped in \\[...\\] from the cursor width calculation.
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y
CONFIG_FEATURE_EDITING_WINCH=n
CONFIG_FEATURE_EDITING_ASK_TERMINAL=n
CONFIG_FEATURE_SUID=n
CONFIG_FEATURE_SYSLOG=n
CONFIG_FEATURE_CLEAN_UP=n
CONFIG_FEATURE_DEVPTS=n
CONFIG_FEATURE_UTMP=n
CONFIG_FEATURE_WTMP=n
CONFIG_FEATURE_SEAMLESS_XZ=n
CONFIG_FEATURE_SEAMLESS_LZMA=n
CONFIG_FEATURE_SEAMLESS_BZ2=n
CONFIG_FEATURE_SEAMLESS_GZ=y
CONFIG_FEATURE_SEAMLESS_Z=n
CONFIG_FEATURE_BUFFERS_USE_MALLOC=y
# Ash uses the native fork/exec, process-group, PTY and waitpid ABI.  LeonOS
# does not yet implement Linux's SIGTTIN/SIGTTOU stop-and-continue protocol;
# enabling ash job-control would loop in setjobctl() before the first prompt.
# Background commands still use the native fork/exec/wait ABI.
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_HUSH=n
CONFIG_SH_IS_HUSH=n
CONFIG_SH_IS_NONE=n
CONFIG_FEATURE_SH_STANDALONE=n
CONFIG_FEATURE_SH_NOFORK=n
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_ASH_INTERNAL_GLOB=y
CONFIG_ASH_BASH_COMPAT=n
CONFIG_ASH_BASH_SOURCE_CURDIR=n
CONFIG_ASH_BASH_NOT_FOUND_HOOK=n
CONFIG_ASH_JOB_CONTROL=n
CONFIG_ASH_ALIAS=y
CONFIG_ASH_RANDOM_SUPPORT=y
CONFIG_ASH_EXPAND_PRMT=y
CONFIG_ASH_IDLE_TIMEOUT=n
CONFIG_ASH_MAIL=n
CONFIG_ASH_ECHO=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_TEST=y
CONFIG_ASH_SLEEP=y
CONFIG_ASH_HELP=y
CONFIG_ASH_GETOPTS=y
CONFIG_ASH_CMDCMD=y
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y
CONFIG_CAT=y
# CONFIG_FEATURE_CATN is not set
CONFIG_FEATURE_CATV=n
CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_FOLLOWLINKS=n
CONFIG_FEATURE_LS_RECURSIVE=n
CONFIG_FEATURE_LS_WIDTH=n
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=n
CONFIG_FEATURE_LS_USERNAME=n
CONFIG_FEATURE_LS_COLOR=y
CONFIG_FEATURE_LS_COLOR_IS_DEFAULT=y
CONFIG_PWD=y
CONFIG_CLEAR=y
CONFIG_HEAD=y
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_TAIL=y
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_WC=y
CONFIG_GREP=y
CONFIG_FEATURE_GREP_CONTEXT=y
CONFIG_SHA256SUM=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_PRINTF=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_CP=y
CONFIG_FEATURE_CP_LONG_OPTIONS=n
CONFIG_FEATURE_CP_REFLINK=n
CONFIG_MV=y
CONFIG_RM=y
CONFIG_ENV=y
CONFIG_PRINTENV=y
CONFIG_NOHUP=y
CONFIG_UNAME=y
CONFIG_UNAME_OSNAME="LeonOS"
CONFIG_SLEEP=y
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_KILLALL=n
CONFIG_UNLINK=y
CONFIG_DIFF=y
CONFIG_FEATURE_DIFF_LONG_OPTIONS=n
CONFIG_FEATURE_DIFF_DIR=n
CONFIG_LESS=y
# Keep the pager bounded on the current fixed user-space address budget.  The
# full BusyBox less default (9,999,999 lines) can otherwise exhaust memory
# before a user has an opportunity to quit a malformed or giant text file.
CONFIG_FEATURE_LESS_MAXLINES=8192
CONFIG_FEATURE_LESS_BRACKETS=n
CONFIG_FEATURE_LESS_FLAGS=n
CONFIG_FEATURE_LESS_TRUNCATE=n
CONFIG_FEATURE_LESS_MARKS=n
CONFIG_FEATURE_LESS_REGEXP=n
CONFIG_FEATURE_LESS_WINCH=n
CONFIG_FEATURE_LESS_ASK_TERMINAL=n
CONFIG_FEATURE_LESS_DASHCMD=n
CONFIG_FEATURE_LESS_LINENUMS=n
CONFIG_FEATURE_LESS_RAW=n
CONFIG_FEATURE_LESS_ENV=n
CONFIG_VI=y
CONFIG_FEATURE_VI_MAX_LEN=256
CONFIG_FEATURE_VI_8BIT=n
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_COLON_EXPAND=n
CONFIG_FEATURE_VI_YANKMARK=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_FEATURE_VI_REGEX_SEARCH=n
CONFIG_FEATURE_VI_USE_SIGNALS=n
CONFIG_FEATURE_VI_DOT_CMD=y
CONFIG_FEATURE_VI_READONLY=y
CONFIG_FEATURE_VI_SETOPTS=y
CONFIG_FEATURE_VI_SET=y
CONFIG_FEATURE_VI_WIN_RESIZE=y
CONFIG_FEATURE_VI_ASK_TERMINAL=n
CONFIG_FEATURE_VI_UNDO=y
CONFIG_FEATURE_VI_UNDO_QUEUE=y
CONFIG_FEATURE_VI_UNDO_QUEUE_MAX=256
CONFIG_FEATURE_VI_VERBOSE_STATUS=y
# CONFIG_FEATURE_TEST_64 is not set

# Additional standard BusyBox applets selected for the LeonOS userland.
CONFIG_AR=y
CONFIG_BB_ARCH=y
CONFIG_ASCII=y
CONFIG_CAL=y
CONFIG_CHGRP=y
CONFIG_CHMOD=y
CONFIG_CHOWN=y
CONFIG_CMP=y
CONFIG_COMM=y
CONFIG_CUT=y
CONFIG_DU=y
CONFIG_EGREP=y
CONFIG_EXPAND=y
CONFIG_FGREP=y
# GNU find and xargs are supplied by the official Alpine findutils APK.
CONFIG_FIND=n
CONFIG_FOLD=y
CONFIG_GETOPT=y
CONFIG_INSTALL=y
CONFIG_LINK=y
CONFIG_LN=y
CONFIG_TAR=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_FEATURE_TAR_GNU_EXTENSIONS=y
CONFIG_GZIP=y
CONFIG_GUNZIP=y
CONFIG_ZCAT=y
CONFIG_MD5SUM=y
CONFIG_NL=y
CONFIG_PASTE=y
CONFIG_READLINK=y
CONFIG_REV=y
CONFIG_SHA1SUM=y
CONFIG_SHA3SUM=y
CONFIG_SHA512SUM=y
CONFIG_SHUF=y
CONFIG_SORT=y
CONFIG_STAT=y
CONFIG_STRINGS=y
CONFIG_SUM=y
CONFIG_TAC=y
CONFIG_TEE=y
CONFIG_TEST=y
CONFIG_TEST1=y
CONFIG_TEST2=y
CONFIG_TR=y
CONFIG_TRUNCATE=y
CONFIG_TTY=y
CONFIG_UNEXPAND=y
CONFIG_UNIQ=y
CONFIG_USLEEP=y
CONFIG_WHOAMI=y
CONFIG_XARGS=n
CONFIG_YES=y
CONFIG_RESET=y
CONFIG_TTYSIZE=y
CONFIG_HALT=y
CONFIG_POWEROFF=y
CONFIG_REBOOT=y
CONFIG_SYNC=y
# Standard networking clients use the Linux socket ABI. HTTPS downloads use
# Python's certificate-verifying TLS client; BusyBox's internal TLS omits it.
CONFIG_WGET=y
CONFIG_FEATURE_WGET_LONG_OPTIONS=y
CONFIG_FEATURE_WGET_STATUSBAR=y
CONFIG_FEATURE_WGET_TIMEOUT=y
CONFIG_FEATURE_WGET_AUTHENTICATION=y
# CONFIG_FEATURE_WGET_HTTPS is not set
# CONFIG_FEATURE_WGET_OPENSSL is not set
CONFIG_NSLOOKUP=y
CONFIG_FEATURE_NSLOOKUP_BIG=y
# Storage commands are external official util-linux/e2fsprogs/dosfstools/
# exfatprogs tools. See docs/UPSTREAM_TOOLS.md for ownership and guest limits.
# fdisk is supplied by util-linux at /usr/sbin/fdisk.
# CONFIG_FDISK is not set
# CONFIG_MKDOSFS is not set
# CONFIG_MKFS_VFAT is not set
# CONFIG_MKE2FS is not set
# CONFIG_MKFS_EXT2 is not set
# CONFIG_MOUNT is not set
# CONFIG_UMOUNT is not set
CONFIG_FEATURE_WAIT_FOR_INIT=n
CONFIG_FEATURE_CALL_TELINIT=n
CONFIG_BASH_IS_ASH=n
CONFIG_BASH_IS_HUSH=n
CONFIG_BASH_IS_NONE=y

# Alpine-style PID 1 and OpenRC shell/runtime dependencies. Official source.
CONFIG_INIT=y
CONFIG_FEATURE_USE_INITTAB=y
CONFIG_FEATURE_INIT_SCTTY=y
CONFIG_FEATURE_INIT_SYSLOG=n
CONFIG_FEATURE_INIT_QUIET=n
CONFIG_FEATURE_KILL_REMOVED=y
CONFIG_GETTY=y
CONFIG_AWK=y
CONFIG_SED=y
CONFIG_PIDOF=y
CONFIG_KILLALL5=y
CONFIG_FEATURE_PIDFILE=y
CONFIG_FEATURE_SHADOWPASSWDS=y
CONFIG_FEATURE_FANCY_SLEEP=y
CONFIG_HOSTNAME=y
CONFIG_DATE=y
CONFIG_TOUCH=y
CONFIG_MKTEMP=y
CONFIG_IFUP=y
CONFIG_IFDOWN=y
CONFIG_IFUPDOWN_IFSTATE_PATH="/run/ifstate"
CONFIG_FEATURE_IFUPDOWN_IP=y
CONFIG_FEATURE_IFUPDOWN_IPV4=y
CONFIG_FEATURE_IFUPDOWN_EXTERNAL_DHCP=y
CONFIG_IFUPDOWN_UDHCPC_CMD_OPTIONS="-R -n -t 3 -T 1"
CONFIG_UDHCPC=y
CONFIG_UDHCPC_DEFAULT_SCRIPT="/usr/share/udhcpc/default.script"
CONFIG_UDHCPC_SLACK_FOR_BUGGY_SERVERS=80
CONFIG_FEATURE_UDHCPC_ARPING=n
CONFIG_FEATURE_UDHCPC_SANITIZEOPT=y
CONFIG_NTPD=y
CONFIG_FEATURE_NTPD_CONF=y
CONFIG_IP=y
CONFIG_FEATURE_IP_ADDRESS=y
CONFIG_FEATURE_IP_LINK=y
CONFIG_FEATURE_IP_ROUTE=y
CONFIG_IFCONFIG=y
CONFIG_ROUTE=y
CONFIG_SYSLOGD=y
CONFIG_KLOGD=y
CONFIG_LOGGER=y
CONFIG_FEATURE_SYSLOGD_READ_BUFFER_SIZE=256
CONFIG_FEATURE_IPC_SYSLOG_BUFFER_SIZE=16
CONFIG_FEATURE_INIT_TERMINAL_TYPE="linux"
CONFIG_INIT_TERMINAL_TYPE="linux"

# Standard identity query used by login diagnostics and service scripts.
CONFIG_ID=y
