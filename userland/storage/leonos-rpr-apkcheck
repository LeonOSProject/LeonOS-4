#!/bin/sh
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

[ "$(id -u)" -eq 0 ] || {
    printf '%s\n' 'leonos-rpr-apkcheck: root privileges are required' >&2
    exit 1
}
[ "$#" -eq 0 ] || {
    printf '%s\n' 'Usage: leonos-rpr-apkcheck' >&2
    exit 2
}

config=/etc/leonos/rpr.conf
[ -r "$config" ] || { printf 'Missing RPR configuration: %s\n' "$config" >&2; exit 1; }
rpr_url=$(sed -n 's/^RPR_BASE_URL=//p' "$config")
key_name=$(sed -n 's/^RPR_PUBLIC_KEY=//p' "$config")
case "$rpr_url" in https://*) ;; *) printf '%s\n' 'Invalid RPR URL: HTTPS is required' >&2; exit 1;; esac
case "$key_name" in ''|*/*|*[!A-Za-z0-9._-]*) printf '%s\n' 'Invalid RPR public-key name' >&2; exit 1;; esac

mkdir -p /etc/apk/keys /etc/apk
key_tmp=$(mktemp /etc/apk/keys/.leonos-rpr-key.XXXXXX)
repo_tmp=$(mktemp /etc/apk/.repositories.XXXXXX)
cleanup() { rm -f -- "$key_tmp" "$repo_tmp"; }
trap cleanup EXIT HUP INT TERM

rprfetch "$rpr_url/apk/$key_name" "$key_tmp"
[ -s "$key_tmp" ] || { printf '%s\n' 'Downloaded RPR public key is empty' >&2; exit 1; }
chmod 0644 "$key_tmp"
mv -f -- "$key_tmp" "/etc/apk/keys/$key_name"

repository="ndx $rpr_url/apk/packages.adb"
if [ -f /etc/apk/repositories ]; then
    awk -v wanted="$repository" '
        $0 == wanted { if (!seen) print; seen=1; next }
        { print }
        END { if (!seen) print wanted }
    ' /etc/apk/repositories >"$repo_tmp"
else
    printf '%s\n' "$repository" >"$repo_tmp"
fi
chmod 0644 "$repo_tmp"
mv -f -- "$repo_tmp" /etc/apk/repositories
trap - EXIT HUP INT TERM

printf 'Installed RPR key: /etc/apk/keys/%s\n' "$key_name"
printf 'Configured APK repository: %s\n' "$repository"
apk update
