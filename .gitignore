# Make output trees (default out/<arch>/<profile>, custom O=out/<name>).
# Keep these anchored: docs/build/, tests/build/ and tools/build/ are source.
/out/
# Shared verified downloads, intentionally retained by make distclean.
/cache/
# Retired build engine outputs retained locally after the Make migration.
/build/
/buildsystem/
/obj/
# Local configuration, CI summaries and interrupted dependency-test fixtures.
/.config
/.config.old
/include/generated/build_info.h
/build-summary.md
/leonos-deps-contract.*/
__pycache__/
*.egg-info/
*.log
*.tmp
.kagent
/dist/
/tools/dist/
/LeonOS4-Developer-SDK.zip
.trae-html-share-packages/
.zig_cache/
# Reference Source Code
/linux/
.worktrees/
