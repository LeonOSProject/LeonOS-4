build/
# The `build/` rule above matches any directory of that name at any depth, which
# would silently exclude the migration documents the build plan requires.
!docs/build/
!tests/build/
buildsystem/firmware/
buildsystem/state/*
!buildsystem/state/build_number.txt
buildsystem/logs/
buildsystem/tmp/
buildsystem/config/
buildsystem/deps/
buildsystem/cache/
.config
__pycache__/
*.egg-info/
*.log
*.tmp
.kagent
dist/
tools/dist/
LeonOS4-Developer-SDK.zip
.trae-html-share-packages/
.zig_cache/
