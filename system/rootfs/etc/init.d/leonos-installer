#!/sbin/openrc-run
description="LeonOS installer"
supervisor=supervise-daemon
input_file=/dev/null
command=/usr/lib/leonos/apps/installer/installer.elf
respawn_delay=5
respawn_max=3
respawn_period=60
output_log=/var/log/installer.log
error_log=/var/log/installer.log
depend() { need leonos-desktop; }
