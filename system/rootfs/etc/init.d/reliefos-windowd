#!/sbin/openrc-run
description="ReliefOS windowd"
supervisor=supervise-daemon
retry=TERM/1/KILL/1
input_file=/dev/null
command=/usr/lib/reliefos/apps/windowd/windowd.elf
respawn_delay=5
respawn_max=3
respawn_period=60
output_log=/var/log/windowd.log
error_log=/var/log/windowd.log
depend() { need reliefos-imd; }
