#!/sbin/openrc-run
description="LeonOS session"
supervisor=supervise-daemon
retry=TERM/1/KILL/1
input_file=/dev/null
command=/usr/lib/leonos/apps/sessiond/sessiond.elf
respawn_delay=5
respawn_max=3
respawn_period=60
output_log=/var/log/sessiond.log
error_log=/var/log/sessiond.log
depend() { need leonos-runtime; }
