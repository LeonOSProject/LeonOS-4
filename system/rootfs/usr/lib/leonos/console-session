#!/bin/sh
# BusyBox init supplies the named VT as fd 0, 1, and 2.
case "$1" in
    tty1|tty2|tty3|tty4|tty5|tty6) ;;
    *) exit 2 ;;
esac

if test "$1" = tty1; then
    if test -f /etc/leonos/installer-runtime &&
       test "$LEONOS_INSTALLER_SESSION" = tui; then
        export HOME=/root
        cd "$HOME" || exit 1
        exec /usr/lib/leonos/apps/login/login.elf --installer-shell
    fi
    if test -f /etc/leonos/desktop-session &&
       test ! -e /run/leonos/graphical-session-started; then
        : > /run/leonos/graphical-session-started
        /usr/lib/leonos/apps/login/login.elf --graphical-session \
            >>/var/log/desktop.log 2>&1
    fi
fi
# Installation media has locked account passwords; offer the same local
# rescue shell on every text VT, including tty1 after the graphical session.
if test -f /etc/leonos/installer-runtime; then
    export HOME=/root
    cd "$HOME" || exit 1
    exec /usr/lib/leonos/apps/login/login.elf --installer-shell
fi
exec /sbin/getty -n -l /usr/lib/leonos/apps/login/login.elf 115200 "$1"
