#!/bin/sh

# Shadow login uses PAM_SILENT for the standard .hushlogin case. pam_exec
# cannot see that flag, so preserve the login convention here.
motd_home=
while IFS=: read -r account password uid gid gecos account_home shell; do
    if [ "$account" = "${PAM_USER-}" ]; then
        motd_home=$account_home
        break
    fi
done < /etc/passwd
if [ -n "$motd_home" ] && [ -e "$motd_home/.hushlogin" ]; then
    exit 0
fi

exec /usr/lib/leonos/motd-status
