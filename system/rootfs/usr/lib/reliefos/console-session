#!/bin/sh
# BusyBox init supplies the named VT as fd 0, 1, and 2.
case "$1" in
    tty1|tty2|tty3|tty4|tty5|tty6) ;;
    *) exit 2 ;;
esac

if test "$1" = tty1; then
    # The kernel keeps only the /proc/cmdline mechanism; the installer UI
    # selection is decided here from the exact boot command line token.
    if test -f /etc/reliefos/installer-runtime &&
       grep -qE '(^| )installer-session=tui( |$)' /proc/cmdline; then
        export HOME=/root
        cd "$HOME" || exit 1
        exec /usr/lib/reliefos/apps/login/login.elf --installer-shell
    fi
    # The installer runtime always keeps the native ReliefOS graphical
    # session, whatever desktop backend the installed system selected.
    if test -f /etc/reliefos/installer-runtime; then
        backend=reliefos
    else
        # /etc/reliefos/desktop-backend is a plain single-line marker file.
        # Only exact reliefos/xorg values are accepted and it is never sourced.
        backend=
        marker_lines=0
        if test -f /etc/reliefos/desktop-backend; then
            while IFS= read -r marker_line || test -n "$marker_line"; do
                marker_lines=$((marker_lines + 1))
                test "$marker_lines" -gt 1 || backend=$marker_line
                marker_line=
            done < /etc/reliefos/desktop-backend
        fi
        case $backend in
            reliefos|xorg) test "$marker_lines" = 1 || backend= ;;
        esac
    fi
    case $backend in
        reliefos)
            if test ! -e /run/reliefos/graphical-session-started; then
                : > /run/reliefos/graphical-session-started
                /usr/lib/reliefos/apps/login/login.elf --graphical-session \
                    >>/var/log/desktop.log 2>&1
            fi
            ;;
        xorg)
            echo "$(date '+%Y-%m-%dT%H:%M:%S') console-session: xorg backend waits for tty1 login before starting Xorg" >>/var/log/xorg-session.log
            ;;
        *)
            echo 'console-session: desktop backend marker is missing or invalid; falling back to text login' >>/var/log/desktop.log
            ;;
    esac
fi
# Installation media has locked account passwords; offer the same local
# rescue shell on every text VT, including tty1 after the graphical session.
if test -f /etc/reliefos/installer-runtime; then
    export HOME=/root
    cd "$HOME" || exit 1
    exec /usr/lib/reliefos/apps/login/login.elf --installer-shell
fi
exec /sbin/getty -n -l /usr/lib/reliefos/apps/login/login.elf 115200 "$1"
