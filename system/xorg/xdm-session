#!/bin/sh
# XDM invokes this script as the authenticated user.
set -u
umask 077

if test -z "${HOME:-}" || test -z "${DISPLAY:-}"; then
    exit 1
fi

uid=$(id -u 2>/dev/null || printf '%s' unknown)
events=/run/reliefos/xorg-events.log
session_log=$HOME/.xsession-errors
: > "$session_log" 2>/dev/null || session_log=${XDG_CACHE_HOME:-/tmp}/reliefos-xsession-errors."$uid"
exec >> "$session_log" 2>&1

event() {
    printf '%s\n' "$1"
    printf '%s\n' "$1" >>"$events" 2>/dev/null || :
}

event 'PAM authentication accepted'

test -x /usr/bin/twm || exit 1
test -x /usr/bin/xterm || exit 1

xterm_pid=
cleanup() {
    if test -n "$xterm_pid"; then
        kill "$xterm_pid" 2>/dev/null || :
        wait "$xterm_pid" 2>/dev/null || :
    fi
}
trap cleanup EXIT HUP INT TERM

/usr/bin/xterm -title ReliefOS -geometry 100x32+0+0 &
xterm_pid=$!
event 'xterm started'
event "twm started for uid=$uid"
/usr/bin/twm -f /etc/reliefos/twmrc
status=$?
event 'xdm session ended'
exit "$status"
