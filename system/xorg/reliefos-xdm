#!/bin/sh
# Root-owned XDM launcher used only by tty1's foreground console session.
set -eu

log=/var/log/xorg-session.log
events=/run/reliefos/xorg-events.log
mkdir -p /var/lib/xdm
mkdir -p /run/reliefos
: > "$events"
chmod 0666 "$events"
touch "$log"
chmod 0644 "$log"

for path in /usr/bin/xdm /etc/reliefos/xdm.conf /etc/reliefos/xdm-Xservers \
    /etc/X11/xorg.conf /usr/lib/reliefos/xdm-session; do
    if test ! -r "$path"; then
        printf '%s\n' "reliefos-xdm: missing $path" >> "$log"
        exit 1
    fi
done

printf '%s\n' 'reliefos-xdm: starting xdm on vt1' >> "$log"
printf '%s\n' 'desktop-backend=xorg' >> "$log"
printf '%s\n' 'xdm started on vt1' >> "$log"
# XDM may close or redirect inherited descriptors for the user session.  Use a
# root-created lifecycle sink instead, then merge fixed, non-secret events.
/usr/bin/xdm -nodaemon -config /etc/reliefos/xdm.conf
status=$?
cat "$events" >> "$log"
printf '%s\n' 'tty1 restored to text login' >> "$log"
rm -f "$events"
exit "$status"
